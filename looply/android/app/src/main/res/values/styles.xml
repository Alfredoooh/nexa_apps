<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/looply_splash_background</item>
        <item name="android:navigationBarColor">@color/looply_splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/looply_splash_background</item>
        <item name="android:statusBarColor">@color/looply_splash_background</item>
        <item name="android:navigationBarColor">@color/looply_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Tema aplicado apenas ao PopupMenu nativo (via ContextThemeWrapper),
         sem alterar o tema geral da Activity. overlapAnchor=false mantém o
         menu a abrir junto ao botão, como o overflow padrão do Android. -->
    <style name="LooplyPopupMenu.Light" parent="@style/Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background_light</item>
        <item name="android:popupElevation">8dp</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="LooplyPopupMenuItemText.Light" parent="@android:style/TextAppearance.Widget.PopupMenu.Large">
        <item name="android:textColor">#FF202124</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>