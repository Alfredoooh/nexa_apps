<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
    </style>
    <!-- Launch themes selected from the app's saved theme preference by MainActivity. -->
    <style name="LaunchTheme.Light" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_light</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="LaunchTheme.Dark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_dark</item>
        <item name="android:statusBarColor">#FF0F0F0F</item>
        <item name="android:navigationBarColor">#FF0F0F0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/looply_splash_background</item>
        <item name="android:statusBarColor">@color/looply_splash_background</item>
        <item name="android:navigationBarColor">@color/looply_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Tema aplicado apenas ao PopupMenu nativo (via ContextThemeWrapper),
         sem alterar o tema geral da Activity. overlapAnchor=false mantém o
         menu a abrir junto ao botão, como o overflow padrão do Android. -->
    <style name="LooplyPopupMenu.Light" parent="@style/Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background_light</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:popupAnimationStyle">@style/LooplyNativePopupWindowAnimation</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="LooplyPopupMenuItemText.Light" parent="@android:style/TextAppearance.Widget.PopupMenu.Large">
        <item name="android:textColor">#FF202124</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LooplyDialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#1A73E8</item>
    </style>

    <style name="LooplyBrowserDialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#1A73E8</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorTertiary">#1A73E8</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF202124</item>
        <item name="android:colorAccent">#1A73E8</item>
    </style>

    <style name="LooplyNativePopupWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/looply_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/looply_popup_exit</item>
    </style>

    <style name="FileViewerTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="OrbitBrowserTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#1A73E8</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorTertiary">#1A73E8</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF202124</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowBackground">#FFFFFFFF</item>
    </style>
</resources>