<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_dark</item>
        <item name="android:windowSplashScreenBackground">@color/looply_splash_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_circle</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">2000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/looply_splash_dark</item>
        <item name="android:navigationBarColor">@color/looply_splash_dark</item>
    </style>
    <style name="LaunchTheme.Light" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_light</item>
        <item name="android:windowSplashScreenBackground">@color/looply_splash_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_circle</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">2000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/looply_splash_light</item>
        <item name="android:navigationBarColor">@color/looply_splash_light</item>
    </style>
    <style name="LaunchTheme.Dark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background_dark</item>
        <item name="android:windowSplashScreenBackground">@color/looply_splash_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_circle</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">2000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/looply_splash_dark</item>
        <item name="android:navigationBarColor">@color/looply_splash_dark</item>
    </style>
</resources>
