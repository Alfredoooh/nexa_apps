<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/looply_splash_background</item>
        <item name="android:navigationBarColor">@color/looply_splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/looply_splash_background</item>
        <item name="android:statusBarColor">@color/looply_splash_background</item>
        <item name="android:navigationBarColor">@color/looply_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Variante escura do tema do PopupMenu nativo. -->
    <style name="LooplyPopupMenu.Dark" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background_dark</item>
        <item name="android:popupElevation">8dp</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="LooplyPopupMenuItemText.Dark" parent="@android:style/TextAppearance.Widget.PopupMenu.Large">
        <item name="android:textColor">#FFE6E6E8</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LooplyDialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#8AB4F8</item>
    </style>

    <!-- Variante escura do bottom sheet nativo do Orbit Browser. -->
    <style name="LooplyBottomSheet.Dark" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="LooplyBottomSheetDialog.Dark" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/LooplyBottomSheet.Dark</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>