<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Equivalentes em modo escuro de LooplyPopupMenu.Light e
         LooplyDialog.Light (values/styles.xml). Sem eles o Kotlin não
         compila: R.style.LooplyPopupMenu_Dark / R.style.LooplyDialog_Dark
         não existiam em nenhum styles.xml. -->
    <style name="LooplyPopupMenu.Dark" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background_dark</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:popupAnimationStyle">@style/LooplyNativePopupWindowAnimation</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="LooplyPopupMenu.Amoled" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background_amoled</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:popupAnimationStyle">@style/LooplyNativePopupWindowAnimation</item>
        <item name="overlapAnchor">false</item>
    </style>
<style name="LooplyDialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#0095F6</item>
    </style>

    <style name="LooplyBrowserDialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#0095F6</item>
        <item name="colorOnPrimary">#FF101114</item>
        <item name="colorSecondary">#0095F6</item>
        <item name="colorOnSecondary">#FF101114</item>
        <item name="colorTertiary">#0095F6</item>
        <item name="colorSurface">#FF121212</item>
        <item name="colorOnSurface">#FFF5F5F5</item>
        <item name="android:colorAccent">#0095F6</item>
    </style>

    <style name="LooplyNativePopupWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/looply_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/looply_popup_exit</item>
    </style>

    <style name="OrbitBrowserTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0095F6</item>
        <item name="colorOnPrimary">#FF101114</item>
        <item name="colorSecondary">#0095F6</item>
        <item name="colorOnSecondary">#FF101114</item>
        <item name="colorTertiary">#0095F6</item>
        <item name="android:colorAccent">#0095F6</item>
        <item name="colorSurface">#FF000000</item>
        <item name="colorOnSurface">#FFF5F5F5</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarDividerColor">#FF000000</item>
    </style>
</resources>