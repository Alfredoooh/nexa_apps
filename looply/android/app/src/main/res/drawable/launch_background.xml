<?xml version="1.0" encoding="utf-8"?>
<!--
  Fundo do tema de arranque (LaunchTheme) usado como windowBackground.
  Splash totalmente nativo: nenhuma View Kotlin é desenhada por cima disto.
  Em Android < 12 este layer-list é a splash inteira (fundo + ícone). Em
  Android 12+ o windowSplashScreenBackground/windowSplashScreenAnimatedIcon
  (ver values-v31/styles.xml) assume o desenho; este drawable continua a
  servir de windowBackground por baixo, com o mesmo ícone, para não haver
  salto visual na transição para a primeira tela da Activity.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/looply_splash_background" />
    </item>
    <item
        android:width="184dp"
        android:height="184dp"
        android:gravity="center">
        <drawable>@drawable/splash_icon</drawable>
    </item>
</layer-list>
