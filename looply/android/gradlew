#!/usr/bin/env sh
# Small Gradle bootstrapper for this ZIP. Uses the pinned Gradle release.
set -eu

# Patch the published m3e_haptics Android module for AGP 9 before Gradle
# configures it. Flutter resolves Pub dependencies before invoking this wrapper.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PATCH_SCRIPT="$PROJECT_DIR/tools/patch_m3e_haptics_agp9.py"
if [ -f "$PATCH_SCRIPT" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Erro: Python 3 é necessário para corrigir m3e_haptics antes do Gradle." >&2
    exit 1
  fi
  python3 "$PATCH_SCRIPT"
fi

VERSION="9.5.0"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
DIST_DIR="$GRADLE_USER_HOME/wrapper/dists/looply-gradle-$VERSION"
GRADLE_BIN="$DIST_DIR/gradle-$VERSION/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_DIR"
  ZIP="$DIST_DIR/gradle-$VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 2 "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$ZIP"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP" "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"
  elif command -v gradle >/dev/null 2>&1 && [ "$(gradle --version 2>/dev/null | awk '/^Gradle / {print $2; exit}')" = "$VERSION" ]; then
    exec gradle "$@"
  else
    echo "Erro: instala Gradle $VERSION ou disponibiliza curl/wget para o descarregar." >&2
    exit 1
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "$ZIP" -d "$DIST_DIR"
  else
    echo "Erro: o comando unzip é necessário para preparar o Gradle." >&2
    exit 1
  fi
  rm -f "$ZIP"
fi
exec "$GRADLE_BIN" "$@"
